    <Target Name="CheckNodeJsExists" BeforeTargets="InstallClientAppDependencies">
        <Exec Command="node --version" ContinueOnError="true">
            <Output TaskParameter="ExitCode" PropertyName="ErrorCode" />
        </Exec>
        <Error Condition="'$(ErrorCode)' != '0'" Text="Node.js is required to build this project. Please install Node.js from https://nodejs.org/ and restart your IDE." />
    </Target>

    <Target Name="InstallClientAppDependencies"
            BeforeTargets="BuildClientApp"
            Inputs="$(SpaRoot)package-lock.json"
            Outputs="$(SpaRoot)node_modules\.install-stamp">

        <Message Importance="high" Text="Restoring client app dependencies from 'npm' because package-lock.json has changed..." />
        <Exec WorkingDirectory="$(SpaRoot)" Command="npm install" />
        <Touch Files="$(SpaRoot)node_modules\.install-stamp" AlwaysCreate="true" />

    </Target>

    <Target Name="BuildClientApp" BeforeTargets="Build" Condition=" '$(Configuration)' == 'Debug' ">
        <Message Importance="high" Text="Building, formatting, and linting client-side assets..." />
        <Exec WorkingDirectory="$(SpaRoot)" Command="npm run build:nocolor">
            <Output TaskParameter="ExitCode" PropertyName="BuildExitCode" />
        </Exec>
        <Error Condition="'$(BuildExitCode)' != '0'" Text="The client-side build (npm run build:nocolor) failed. See the Build output window for details." />
    </Target>

</Project>
