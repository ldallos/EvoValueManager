{
    "name": "evovaluemanager-client",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "npm run format && npm run lint && tsc && vite build",
        "build:nocolor": "npm run format && npm run lint && tsc && vite build --log-level error",
        "preview": "vite preview",
        "cleanDist": "rimraf dist",
        "lint": "eslint . --ext ts,tsx --report-unused-disable-directives",
        "format": "prettier --write --log-level warn \"src/**/*.{ts,tsx,css,json}\"",
        "prepare": "husky"
    },
    "dependencies": {
        "@headlessui/react": "^2.2.4",
        "@heroicons/react": "^2.2.0",
        "@hookform/resolvers": "^5.1.1",
        "@tailwindcss/vite": "^4.1.10",
        "@tanstack/react-query": "^5.81.1",
        "axios": "^1.8.4",
        "clsx": "^2.1.1",
        "framer-motion": "^12.23.0",
        "i18next": "^25.1.1",
        "i18next-browser-languagedetector": "^8.1.0",
        "lucide-react": "^0.523.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-hook-form": "^7.58.1",
        "react-hot-toast": "^2.5.2",
        "react-i18next": "^15.5.1",
        "react-router-dom": "^7.4.1",
        "recharts": "^3.0.2",
        "rimraf": "^6.0.1",
        "tailwind-merge": "^3.3.1",
        "zod": "^3.25.67"
    },
    "devDependencies": {
        "@eslint/js": "^9.21.0",
        "@tailwindcss/postcss": "^4.1.10",
        "@types/node": "^24.0.10",
        "@types/react": "^19.0.10",
        "@types/react-dom": "^19.0.4",
        "@types/react-i18next": "^7.8.3",
        "@types/recharts": "^1.8.29",
        "@vitejs/plugin-react-swc": "^3.8.0",
        "autoprefixer": "^10.4.21",
        "cross-env": "^7.0.3",
        "eslint": "^9.21.0",
        "eslint-config-prettier": "^10.1.5",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-prettier": "^5.5.1",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^5.1.0",
        "eslint-plugin-react-refresh": "^0.4.19",
        "globals": "^15.15.0",
        "husky": "^9.1.7",
        "lint-staged": "^16.1.2",
        "postcss": "^8.5.6",
        "prettier": "^3.5.3",
        "tailwindcss": "^4.1.10",
        "typescript": "~5.7.2",
        "typescript-eslint": "^8.24.1",
        "vite": "^6.2.0",
        "vite-plugin-mkcert": "^1.17.8"
    },
    "lint-staged": {
        "src/**/*.{ts,tsx}": [
            "prettier --write",
            "eslint --fix"
        ],
        "src/**/*.{css,json}": "prettier --write"
    }
}
